# Kondoo Bot Configuration Template
# -----------------------------------------------------------------------------
# INSTRUCTIONS:
# 1. Copy this file to ".env" in your specific bot deployment directory.
# 2. Fill in the required values.
# 3. Do NOT commit your final ".env" file to Git if it contains real keys.
# -----------------------------------------------------------------------------

# =============================================================================
#  1. PROVIDER SELECTION
#  Choose the backend services for intelligence and memory.
# =============================================================================

# -- Answer Engine Provider --
#  The LLM service that will generate the final response.
#  - Options: "gemini", "openai", "ollama_compatible"
ANSWER_LLM_PROVIDER=gemini

# -- Knowledge Provider --
#  The service used to generate/read vector embeddings.
#  - Options: "ollama", "openai", "local"
KNOWLEDGE_PROVIDER=ollama


# =============================================================================
#  2. ANSWER ENGINE CONFIGURATION (For ANSWER_LLM_PROVIDER)
# =============================================================================

# --- General Settings ---
# The specific model name (e.g., "models/gemini-1.5-flash", "gpt-4o", "llama3")
LLM_MODEL_NAME="models/gemini-1.5-flash"

# --- For Cloud Providers (gemini, openai) ---
# Your secret API key.
LLM_API_KEY="your_api_key_here"

# --- For Self-Hosted Providers (ollama_compatible) ---
# The base URL of your local LLM service (e.g., vLLM, Ollama via API).
# LLM_BASE_URL="http://host.docker.internal:11434/v1"


# =============================================================================
#  3. KNOWLEDGE ENGINE CONFIGURATION (For KNOWLEDGE_PROVIDER)
# =============================================================================

# --- Embedding Configuration ---
# The model used to vectorize text. Must match the one used during ingestion (SynapsIA).
# Example: "mxbai-embed-large"
EMBEDDING_MODEL_NAME="mxbai-embed-large"

# --- For Ollama Provider ---
# Base URL for the embedding service.
OLLAMA_BASE_URL="http://host.docker.internal:11434"


# =============================================================================
#  4. BOT IDENTITY & BEHAVIOR (The "Soul" of the Bot)
# =============================================================================

# -- Persona File (Identity) --
# Path to the YAML file defining specific attributes (Name, Role, Location).
# Default inside container: /app/config/persona.yaml
BOT_PERSONA_FILE=/app/config/persona.yaml

# -- Behavior File (Guidelines) --
# Path to the TXT/MD file defining global interaction rules and standards.
# Default inside container: /app/config/behavior.txt
BOT_BEHAVIOR_FILE=/app/config/behavior.txt


# =============================================================================
#  5. DATA STORAGE
# =============================================================================

# -- Knowledge Base Directory --
# Internal path where the vector index (created by SynapsIA) is mounted.
KNOWLEDGE_DIR=/app/knowledge